# Copy to .env and adjust as needed. Every value has a working default.
# Host port the web UI is published on (container always listens on 8080).
PURSUARR_PORT=8080

# Optional: configure Prowlarr connection via environment variables instead of (or as defaults for) settings.php
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=your_api_key_here
